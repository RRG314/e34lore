# Dependencies
/node_modules
/.pnp
.pnp.*
# Keep authored Yarn tooling if the project adopts Yarn.
/.yarn/*
!/.yarn/patches/
!/.yarn/plugins/
!/.yarn/releases/
!/.yarn/versions/

# Generated builds and framework state
/dist/
/.next/
/.vinext/
/out/
next-env.d.ts
*.tsbuildinfo

# Test output
/coverage/

# Package-manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local environment and keys
.env*
!/.env.example
.dev.vars*
*.pem

# Checkout-local tool state
/.wrangler/
/.sites-runtime/
/.openai/hosting.json

# Workspace scaffolding and publication archives
/.agents/
/.codex/
/outputs/
/work/

# OS metadata
.DS_Store

# Private source material and temporary QA
/private/
/public/qa-responsive.html
/tmp-resolution.log
**/__pycache__/

# Supabase CLI local metadata
/supabase/.temp/

# Android local toolchains, build products and signing credentials
/android/node_modules/
/android/project/.gradle/
/android/project/.kotlin/
/android/project/local.properties
/android/project/**/build/
/android/.private/
**/*.keystore
**/*.jks

# Isolated browser verification artifacts
/.playwright-cli/

# Reproduced from pinned npm dependencies and verified language data at build.
/public/scanner-runtime/

# Private browser verification screenshots
/output/playwright/
