# Development defaults to the Supabase CLI's loopback API.
# Fill in the publishable key or legacy anon key from your local stack.
# These settings are included in the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Use the local backend in a production-mode build.
E34_LOCAL_BUILD=1
