import fs from 'node:fs/promises';
import {manualGuides,manualChapters} from '../src/data/manual.ts';
import {guideRevision} from '../src/domain/walkthrough.ts';
import {repairPlan} from '../src/repair/plan.ts';
import {toolList} from '../src/servicing/service.ts';
import {componentCatalog} from '../src/digital-twin/public/catalog.ts';
import {parseReference} from '../src/digital-twin/public/model.ts';
import {componentCoverage} from '../src/servicing/component-coverage.ts';
const read=async(p:string)=>JSON.parse(await fs.readFile(p,'utf8'));
const releases=[await read('data/digital-twin/525i-automatic-reference.json'),await read('data/digital-twin/public-reference.json'),...await read('data/digital-twin/vehicle-references.json')];
const guideIndex=new Map(manualGuides.map(g=>[g.slug,g]));
const guides=manualGuides.map(g=>({id:g.slug,revision:guideRevision(g.slug)?.revision,system:g.system,engines:g.engines,sourceChecked:g.sourceChecked,reviewStatus:g.reviewStatus,kind:g.kind,source:g.source,tools:toolList(g).length,stepToolAssignments:g.slug===repairPlan.guide||!!g.jobSupport,dependencyGraph:g.slug===repairPlan.guide,structuredInspection:g.slug===repairPlan.guide,estimatedDuration:g.duration,durationBasis:g.durationBasis,verifiedLaborTime:false}));
const references=[],components=[];
for(const release of releases){const model=parseReference(await read('public'+release.manifestUrl)),catalog=model.catalog||componentCatalog;references.push({id:model.id,revision:model.revision,renderable:model.nodes.filter(n=>n.assetId).length,sourceContext:catalog.context,coverage:catalog.coverage});
 for(const node of model.nodes.filter(n=>n.assetId)){const binding=catalog.bindings[node.id],linked=(binding?.guideIds||[]).map(id=>guideIndex.get(id)).filter(Boolean);components.push({model:model.id,revision:model.revision,node:node.id,name:node.name,oemPositions:binding?.positions.length||0,sourceCatalogAssemblies:binding?.assemblyIds.length||0,sourceDiagram:'Resolved separately by the source catalog; not certified from this association',illustrative3D:true,guides:linked.map(g=>g!.slug),structuredTools:linked.length>0,stepTools:linked.some(g=>g!.slug===repairPlan.guide||!!g!.jobSupport),accessPrerequisites:linked.some(g=>g!.slug===repairPlan.guide),inspection:linked.some(g=>g!.slug===repairPlan.guide||g!.kind==='inspection'),reassemblyStructured:linked.some(g=>g!.slug===repairPlan.guide),relatedInspectionOpportunities:linked.some(g=>g!.slug===repairPlan.guide),verifiedFitment:'Separate fitment evidence; model mapping does not establish compatibility',community:'Existing part/guide-linked published-discussion query',mechanicallyVerifiedRemoval:false,facets:componentCoverage(node,binding,{id:model.id,revision:model.revision,assetSha256:model.assets.find(asset=>asset.id===node.assetId)?.sha256})});}
}
const result={schemaVersion:1,releaseStatus:'local-only; owner acceptance pending',manualChapters:manualChapters.length,guides,references,components};
await fs.mkdir('docs/servicing',{recursive:true});await fs.writeFile('docs/servicing/coverage.json',JSON.stringify(result,null,2)+'\n');
await fs.writeFile('docs/servicing/coverage.md',`# Component servicing coverage\n\nGenerated from the existing guide revisions, catalog bindings and runtime manifests. Audit inventory, not a replacement component database. No physical removal path or factory-CAD certification is claimed.\n\n${manualGuides.length} existing guides; ${manualChapters.length} manual chapter indexes; ${references.length} reference configurations; ${components.length} selectable model instances.\n\n| Guide | Source checked | Tool list | Step tools | Access graph | Duration basis |\n| --- | --- | --- | --- | --- | --- |\n`+guides.map(g=>`| ${g.id} | ${g.sourceChecked?'yes':'no'} | ${g.tools} | ${g.stepToolAssignments?'indexed':'not indexed'} | ${g.dependencyGraph?'indexed':'not indexed'} | ${g.durationBasis} |`).join('\n')+'\n\nOEM options preserve their source conditions. A catalog association is not verified fitment. Diagram availability remains an existing catalog query. Community links do not imply that a published discussion exists. Detailed per-instance coverage is in coverage.json. Real sound labels, lab-tested electrical limits, professional labor times, approved current quotes and specialist verification are separate evidence dependencies.\n');
const defaultReference=references.find(r=>r.id==='e34-525i-sedan-automatic'),defaultComponents=components.filter(c=>c.model===defaultReference?.id&&c.revision===defaultReference?.revision);
const legacyPath='data/digital-twin/legacy-graph-coverage.json';
try{await fs.access(legacyPath);}catch{await fs.copyFile('data/digital-twin/coverage.json',legacyPath);}
await fs.writeFile('data/digital-twin/coverage.json',JSON.stringify({schemaVersion:2,configurationId:defaultReference?.id,revision:defaultReference?.revision,scope:'Current runtime manifest audit. Counts describe source associations, not a complete mechanical reconstruction.',geometryAvailable:defaultComponents.filter(c=>c.facets.geometry).length,individuallySelectable:defaultComponents.filter(c=>c.facets.selectable).length,sourceLinked:defaultComponents.filter(c=>c.facets.catalogCandidates>0).length,withSpecificManualLocator:defaultComponents.filter(c=>c.facets.specificManualReferences>0).length,withGeneralManualLocatorOnly:defaultComponents.filter(c=>!c.facets.specificManualReferences&&c.facets.generalManualReferences>0).length,withAuthoredRepairGuide:defaultComponents.filter(c=>c.facets.authoredRepairGuides>0).length,withStructuredProcedure:defaultComponents.filter(c=>c.facets.structuredProcedures>0).length,outerEnvelopeChecked:defaultComponents.filter(c=>c.facets.outerEnvelope).length,dimensionallyVerifiedComponents:0,missingGeometry:['Automatic gearbox internals','Torque converter'],unverified:['Full dimensional accuracy','Installed component placement','Mounting interfaces','Physical removal clearances'],legacyGraphAudit:legacyPath},null,2)+'\n');
console.log(JSON.stringify({guides:guides.length,chapters:manualChapters.length,references:references.length,modelInstances:components.length,default525i:defaultComponents.length}));
